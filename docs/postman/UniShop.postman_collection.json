{
  "info": {
    "name": "UniShop API",
    "description": "Auth, public catalog, and admin CRUD requests for the local Development API.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "adminEmail", "value": "admin@unishop.local" },
    { "key": "adminPassword", "value": "Admin1234" },
    { "key": "token", "value": "" },
    { "key": "categoryId", "value": "1" },
    { "key": "supplierId", "value": "1" },
    { "key": "deliveryMethodId", "value": "1" },
    { "key": "productId", "value": "" },
    { "key": "createdCategoryId", "value": "" },
    { "key": "createdSupplierId", "value": "" },
    { "key": "createdDeliveryMethodId", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register client",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Postman Client\",\n  \"email\": \"postman-{{$randomInt}}@example.test\",\n  \"password\": \"ClientPass123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/auth/register"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Client registered', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('token', pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login seeded admin",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Admin login succeeded', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('token', pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Current user",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/auth/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Current user returned', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "Categories with product counts",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/categories" },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Categories returned', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Product list and paging",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/products?page=1&pageSize=12&sort=newest"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Paged products returned', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Search and filters",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/products?search=wireless&minPrice=100&maxPrice=500&inStock=true&sort=price_asc"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Filtered products returned', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Product details",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/products/1" },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Product details returned', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Products by IDs (guest cart)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/products/by-ids?ids=1,2,3"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Products by IDs returned', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Admin",
      "auth": {
        "type": "bearer",
        "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
      },
      "item": [
        {
          "name": "List all products (including inactive)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/admin/products?page=1&pageSize=20"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Admin product list returned', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create product",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Product {{$randomInt}}\",\n  \"description\": \"Created from the UniShop Postman collection.\",\n  \"specifications\": [{ \"key\": \"Color\", \"value\": \"Green\" }],\n  \"price\": 129.99,\n  \"stock\": 12,\n  \"imageUrl\": null,\n  \"isActive\": true,\n  \"categoryId\": {{categoryId}},\n  \"supplierId\": {{supplierId}},\n  \"deliveryMethodIds\": [{{deliveryMethodId}}]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/admin/products"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Product created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('productId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Read created product",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/admin/products/{{productId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Admin product returned', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update created product",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Product Updated\",\n  \"description\": \"Updated from the collection.\",\n  \"specifications\": [{ \"key\": \"Color\", \"value\": \"Coral\" }],\n  \"price\": 149.99,\n  \"stock\": 10,\n  \"imageUrl\": null,\n  \"isActive\": true,\n  \"categoryId\": {{categoryId}},\n  \"supplierId\": {{supplierId}},\n  \"deliveryMethodIds\": [{{deliveryMethodId}}]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/admin/products/{{productId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Product updated', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete created product",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/admin/products/{{productId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Product deleted', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "Categories",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/admin/categories"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Admin categories returned', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create category",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Category {{$randomInt}}\",\n  \"description\": \"Created by Postman\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/admin/categories"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Category created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('createdCategoryId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Update category",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Category Updated {{$randomInt}}\",\n  \"description\": \"Updated by Postman\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/admin/categories/{{createdCategoryId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Category updated', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete category",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/admin/categories/{{createdCategoryId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Category deleted', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "Suppliers",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/admin/suppliers"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Admin suppliers returned', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create supplier",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Supplier {{$randomInt}}\",\n  \"contactEmail\": \"postman-{{$randomInt}}@example.test\",\n  \"phone\": \"+1-555-0199\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/admin/suppliers"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Supplier created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('createdSupplierId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Update supplier",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Supplier Updated {{$randomInt}}\",\n  \"contactEmail\": \"postman-updated-{{$randomInt}}@example.test\",\n  \"phone\": \"+1-555-0188\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/admin/suppliers/{{createdSupplierId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Supplier updated', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete supplier",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/admin/suppliers/{{createdSupplierId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Supplier deleted', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "Delivery methods",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/admin/delivery-methods"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Delivery methods returned', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create delivery method",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Delivery {{$randomInt}}\",\n  \"price\": 12.5,\n  \"estimatedDays\": 2\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/admin/delivery-methods"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Delivery method created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('createdDeliveryMethodId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Update delivery method",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Delivery Updated {{$randomInt}}\",\n  \"price\": 18,\n  \"estimatedDays\": 1\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/admin/delivery-methods/{{createdDeliveryMethodId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Delivery method updated', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete delivery method",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/admin/delivery-methods/{{createdDeliveryMethodId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Delivery method deleted', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "In-use category deletion conflict",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/admin/categories/{{categoryId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('In-use category returns conflict', () => pm.response.to.have.status(409));",
                  "pm.test('Conflict explains why', () => pm.expect(pm.response.json().detail).to.include('products'));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
