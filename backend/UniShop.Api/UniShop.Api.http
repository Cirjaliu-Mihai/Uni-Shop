@baseUrl = http://localhost:5000
@token = {{login.response.body.token}}

### Register a client
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
	"fullName": "Test Client",
	"email": "client@example.test",
	"password": "ClientPass123"
}

### Log in
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
	"email": "admin@unishop.local",
	"password": "<configured-admin-password>"
}

### Get current account
GET {{baseUrl}}/api/auth/me
Accept: application/json
Authorization: Bearer {{token}}

###

### Check admin authorization
GET {{baseUrl}}/api/admin/access-check
Authorization: Bearer {{token}}

### Create a Stripe Checkout session for a card order
POST {{baseUrl}}/api/payments/1/checkout-session
Authorization: Bearer {{token}}

### Stripe webhook (use Stripe CLI to provide a valid Stripe-Signature)
POST {{baseUrl}}/api/payments/webhook
Stripe-Signature: {{stripeSignature}}
Content-Type: application/json

{}

### Search and page admin users
GET {{baseUrl}}/api/admin/users?search=client&page=1&pageSize=20
Authorization: Bearer {{token}}

### Lock or unlock a user
PATCH {{baseUrl}}/api/admin/users/{{userId}}/lock
Authorization: Bearer {{token}}

### Unlock a user
PATCH {{baseUrl}}/api/admin/users/{{userId}}/unlock
Authorization: Bearer {{token}}

### Change a user's role
PATCH {{baseUrl}}/api/admin/users/{{userId}}/role
Authorization: Bearer {{token}}
Content-Type: application/json

{
	"role": "Client"
}

### Sales report grouped by day, week, or month
GET {{baseUrl}}/api/admin/reports/sales?from=2026-01-01T00%3A00%3A00Z&to=2026-12-31T23%3A59%3A59Z&groupBy=month
Authorization: Bearer {{token}}

### Popular products report
GET {{baseUrl}}/api/admin/reports/popular-products?from=2026-01-01T00%3A00%3A00Z&to=2026-12-31T23%3A59%3A59Z&top=10
Authorization: Bearer {{token}}

### List categories with active product counts
GET {{baseUrl}}/api/categories
Accept: application/json

### Browse active products
GET {{baseUrl}}/api/products?page=1&pageSize=12&sort=newest
Accept: application/json

### Search and filter catalog
GET {{baseUrl}}/api/products?search=wireless&minPrice=100&maxPrice=500&inStock=true&sort=price_asc&page=1&pageSize=12
Accept: application/json

### Get a product by ID
GET {{baseUrl}}/api/products/1
Accept: application/json

### Get products for a guest cart
GET {{baseUrl}}/api/products/by-ids?ids=1,2,3
Accept: application/json

### Weather forecast sample
GET {{baseUrl}}/weatherforecast/
Accept: application/json
